{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "logLevel": "INFO",
  
  // Opencode Web and serve - IMPROVE AND EXPLORE
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
    "mdns": true // allow network discovery
  },
  
  // Ignored directories for file watcher
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/node_modules/**",
      "**/.terraform/**",
      "**/dist/**",
      "**/build/**",
      "**/.cache/**",
      "**/.venv/**"
    ]
  },
  "plugin": [
    // "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "command": {
    "docs": {
      "description": "Generate technical documentation for the current code",
      "template": "Generate clear technical documentation for the provided code or current file. Focus on data structures, algorithmic flow, memory management, and any specific hardware or performance constraints.",
      "agent": "build"
    },
    "debug": {
      "description": "Deep debug",
      "template": "Run the tests and fix any failing logic. Use terminal commands to verify.",
      "agent": "build_pro"
    }
  },
  
  // "snapshot": true,
  "share": "manual", // Share conversation with link - EXPLORE
  "autoupdate": "notify",
  "formatter": true,
  "lsp": true,
  "default_agent": "plan",
  
  "provider": {
    "{{ opencode_provider_name }}": {
      "models": {
        "{{ opencode_plan_pro_model }}": {
          "reasoning": true,
          "temperature": true,
          "variants": {
            "max_reasoning": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "thinking": { "type": "enabled", "budgetTokens": 32000 }
            }
          }
        },
        "{{ opencode_plan_model }}": {
          "reasoning": true,
          "temperature": true,
          "variants": {
            "medium_reasoning": {
              "reasoningEffort": "medium",
              "thinking": { "type": "enabled", "budgetTokens": 16000 }
            }
          }
        },
        "{{ opencode_build_pro_model }}": {
          "reasoning": true,
          "temperature": true,
          "variants": {
            "low_reasoning": {
              "reasoningEffort": "low",
              "thinking": { "type": "disabled" }
            }
          }
        },
        "{{ opencode_build_model }}": {
          "reasoning": false,
          "temperature": true,
          "variants": {
            "no_reasoning": {
              "reasoningEffort": "none",
              "thinking": { "type": "disabled" }
            }
          }
        },
        "{{ opencode_chat_model }}": {
          "reasoning": false,
          "temperature": true,
          "variants": {
            "no_reasoning": {
              "reasoningEffort": "none",
              "thinking": { "type": "disabled" }
            }
          }
        }
      }
    }
  },
  
  "agent": {
    "plan_pro": {
      "description": "Architectural planning mode using a PREMIUM reasoning model. Use only for complex system design.",
      "mode": "primary",
      "model": "{{ opencode_provider_name }}/{{ opencode_plan_pro_model }}",
      "variant": "max_reasoning",
      "temperature": 0.0,
      "top_p": 0.1,
      "prompt": "You are an expert software architect handling complex design tasks. Design system architecture, evaluate patterns, and create step-by-step implementation plans. Focus on rigorous logic, security, and maintainability. You are strictly forbidden from writing or modifying actual codebase files.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "plan": {
      "description": "Standard planning mode. Outlines task breakdowns and logic for daily coding.",
      "mode": "primary", 
      "model": "{{ opencode_provider_name }}/{{ opencode_plan_model }}",
      "variant": "medium_reasoning",
      "temperature": 0.0,
      "top_p": 0.1,
      "prompt": "You are a software architect. Draft implementation plans and logic structures. Do not edit actual codebase files.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build_pro": {
      "description": "Premium implementation mode. Fast, highly capable model focused on complex refactoring and hard bugs.",
      "mode": "primary",
      "model": "{{ opencode_provider_name }}/{{ opencode_build_pro_model }}",
      "variant": "low_reasoning",
      "temperature": 0.3,
      "top_p": 0.8,
      "prompt": "You are a senior software engineer handling complex implementation. Write clean, efficient code. If deep bugs or compilation errors arise, fix them autonomously.",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "build": {
      "description": "Standard implementation mode. Cost-effective model for routine coding and boilerplate.",
      "mode": "primary",
      "model": "{{ opencode_provider_name }}/{{ opencode_build_model }}",
      "variant": "no_reasoning",
      "temperature": 0.3,
      "top_p": 0.8,
      "prompt": "You are a software developer. Implement the provided instructions efficiently. Fix minor bugs autonomously.",
      "permission": {
        "edit": "allow",
        "bash": "ask"
      }
    },
    "chat": {
      "description": "Conversational assistant for code discussion, theory, and brainstorming.",
      "mode": "primary",
      "model": "{{ opencode_provider_name }}/{{ opencode_chat_model }}",
      "variant": "no_reasoning",
      "temperature": 0.7,
      "top_p": 0.95,
      "prompt": "You are a helpful pair-programming assistant. Discuss logic, explain complex programming concepts, and brainstorm solutions with the user. Your main goal is chat about the code and not to implement code or run commands.",
      "permission": {
        "edit": "ask",
        "bash": "ask"
      }
    }
  }
}